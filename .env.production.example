# ==========================================
# PROCTORGUARD SAAS - PRODUCTION ENVIRONMENT
# ==========================================

# 1. DATABASE CONNECTION
# Connect to your free PostgreSQL provider (Neon, Supabase, Render, Railway, or Aiven)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/proctorguard?sslmode=require"

# 2. JWT SECURITY SECRET (Minimum 32 random characters)
JWT_SECRET="generate_a_secure_random_64_character_hex_secret_here"

# 3. APPLICATION DOMAIN
# Replace with your production domain (e.g., https://proctorguard.vercel.app or custom domain)
NEXT_PUBLIC_APP_URL="https://your-proctorguard-domain.vercel.app"

# 4. NODE ENVIRONMENT
NODE_ENV="production"
PORT=3000
